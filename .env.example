# Copy to .env for local use, or set these in your hosting dashboard.
ADMIN_PASSWORD=choose-a-long-password
PORT=3000
# Where the session snapshot is kept. On a VPS use a persistent folder; on Render a persistent disk path.
DATA_DIR=./data
# Seconds per question (optional)
PRACTICE_SECONDS=15
COMPETITION_SECONDS=15
MAX_PLAYERS=500
